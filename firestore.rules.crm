// ===== Vanguard CRM rules =====
// PASTE these blocks INSIDE your existing ironhalolite rules, inside
//   match /databases/{database}/documents { ... }
// Do not replace the IronHalo rules. Add these next to them.

    function crm() {
      return request.auth != null && request.auth.token.crm == true;
    }
    function crmAdmin() {
      return crm() && get(/databases/$(database)/documents/crm_users/$(request.auth.token.crmId)).data.admin == true;
    }

    // Employee list. Everyone signed in reads it; only admins change it.
    // PINs are never here. They live in crm_secrets, which only the server can touch.
    match /crm_users/{id} {
      allow read: if crm();
      allow create, update: if crmAdmin()
        && !request.resource.data.keys().hasAny(['hash', 'salt']);
      allow delete: if false;
    }
    match /crm_secrets/{id} {
      allow read, write: if false;
    }

    match /crm_accounts/{id} {
      allow read, create, update: if crm();
      allow delete: if crmAdmin();
    }
    match /crm_deals/{id} {
      allow read, create, update: if crm();
      allow delete: if crmAdmin();
    }
    match /crm_reminders/{id} {
      allow read, create, update: if crm();
      allow delete: if crmAdmin();
    }

    // Audit log: anyone can add an entry, but only as themselves, and nobody can edit or delete one.
    match /crm_activity/{id} {
      allow read: if crm();
      allow create: if crm() && request.resource.data.loggedBy == request.auth.token.crmName;
      allow update, delete: if false;
    }
// ===== end Vanguard CRM rules =====
